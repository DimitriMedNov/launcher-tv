<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Opaca a propósito: en la Hisense del cuarto (Android 11) el tema del sistema dejaba la ventana
        como translúcida y, al volver con Home, se seguía viendo la app de atrás mientras el control
        movía el launcher invisible.
    -->
    <style name="Theme.LauncherTv" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
